[Unit]
Description=Set OmniOS live session passwords
Documentation=man:chpasswd(8)
# systemd-sysusers creates 'omni' with a locked password, so without this the
# account cannot log in on any tty other than the autologin one — no second
# shell, no ssh, no recovery. A live image needs a known credential.
After=systemd-sysusers.service
Before=getty.target systemd-user-sessions.service
ConditionPathExists=/usr/bin/chpasswd

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/sh -c 'printf "omni:omnios\nroot:omnios\n" | chpasswd'

[Install]
WantedBy=multi-user.target
