#!/usr/bin/env bash
# Opens the settings app.
#
# This wrapper exists for one line of gnome-control-center's own main():
#
#     Running gnome-control-center is only supported under GNOME and Unity,
#     exiting
#
# It reads XDG_CURRENT_DESKTOP and refuses to start anywhere else. Under
# Hyprland that variable says "Hyprland", so the settings app exits 1 before it
# draws anything — which looks exactly like a tile that does nothing.
#
# The gate is a policy, not a capability: the panels themselves talk to
# PipeWire, NetworkManager, bluez, UPower and systemd-hostnamed, all of which
# this image runs, and they work here. So the variable is overridden for this
# one process.
#
# For this one process, and deliberately not for the session: xdg-desktop-portal
# picks its backend from the same variable, and a session-wide GNOME would send
# every file chooser looking for the GNOME portal, which is not installed. The
# display panel is the one that genuinely needs GNOME — it drives mutter — and
# it stays broken here. Everything else in the list works.
set -uo pipefail

command -v gnome-control-center >/dev/null 2>&1 || {
    echo "error: gnome-control-center is missing" >&2
    exit 1
}

exec env XDG_CURRENT_DESKTOP=GNOME gnome-control-center "$@"
