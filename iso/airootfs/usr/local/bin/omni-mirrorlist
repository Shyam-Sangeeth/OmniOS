#!/usr/bin/env bash
# omni-mirrorlist — make sure pacman has somewhere to download from.
#
# pacman-mirrorlist ships with every server commented out, and mkarchiso builds
# the image against the mirror in its own profile rather than the one that ends
# up on the running system. So pacman works all through the build and then fails
# on the console with:
#
#   error: failed to synchronize all databases (no servers configured for repository)
#
# which is exactly what the Store tab hits the first time anyone installs
# something.
#
# Writes a mirror only when none is active, so an installed OmniOS that already
# has a real mirrorlist is left alone.
set -euo pipefail

readonly LIST=/etc/pacman.d/mirrorlist

[[ -f $LIST ]] || exit 0

if grep -q '^[[:space:]]*Server' "$LIST"; then
    exit 0
fi

# geo.mirror.pkgbuild.com is Arch's own geo-routed mirror, so this needs no
# guess about where the machine is; the Tier 1 mirror covers the case where the
# geo router itself is unreachable.
cat >>"$LIST" <<'MIRRORS'

## Added by OmniOS: the shipped list had no active server.
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
MIRRORS
