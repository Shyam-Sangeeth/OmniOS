#!/usr/bin/env bash
# Bring a window to the front in Plasma, by its app id or by a process's id.
#
#   omni-kwin-activate omni-launcher
#   omni-kwin-activate --pid 4242 4243 4250
#
# A Wayland app cannot raise itself: that is focus stealing, and KWin answers it
# by flashing the taskbar entry instead. KWin's own scripting can, so this hands
# it a three-line script over D-Bus — load, run, unload — the way kdotool does.
# It is how the controller's Guide button gets back to the library from inside a
# running game, and how "Game Mode" finds a launcher that is already open.
#
# --pid is the way back into the game: a game's window class is whatever its
# engine chose, but its process is known — the launcher started it, or Steam's
# reaper did — so the first window belonging to any of the given processes is
# the one raised.
set -uo pipefail

usage() { echo "usage: omni-kwin-activate APP_ID | --pid PID..." >&2; exit 2; }
[ $# -ge 1 ] || usage

if [ "$1" = "--pid" ]; then
    shift
    [ $# -ge 1 ] || usage
    pids=""
    for pid in "$@"; do
        # Numbers only: they go into the script as a list literal.
        case "$pid" in ''|*[!0-9]*) usage ;; esac
        pids="${pids:+$pids, }$pid"
    done
    match="[$pids].includes(window.pid)"
else
    # Escaped before it goes into the script, so a quote in the app id cannot
    # end the string literal. Done here rather than inside the here-document,
    # where the shell would process the backslashes a second time.
    app_js="$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    match="window.resourceClass === \"$app_js\""
fi

uid="$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR:-/run/user/$uid}/bus}"

script="$(mktemp --suffix=.js)"
trap 'rm -f "$script"' EXIT
cat >"$script" <<EOF
for (const window of workspace.windowList()) {
    if (window.normalWindow && $match) {
        window.minimized = false;
        workspace.activeWindow = window;
        break;
    }
}
EOF

name="omnios-activate-$$"
kwin() { dbus-send --session --print-reply --dest=org.kde.KWin "$@" 2>/dev/null; }

id="$(kwin /Scripting org.kde.kwin.Scripting.loadScript string:"$script" string:"$name" \
      | awk '/int32/ { print $2 }')"
[ -n "$id" ] || exit 1
kwin "/Scripting/Script$id" org.kde.kwin.Script.run >/dev/null
kwin /Scripting org.kde.kwin.Scripting.unloadScript string:"$name" >/dev/null
exit 0
