#!/usr/bin/env bash
# omni-launcher — the shell Hyprland starts (OmniOS.md §5.3.3, exec-once).
#
# Phase 10's Qt6/QML tile grid is not built yet. Until it is, this stands in
# for it and does the one thing that matters for validating the image: it runs
# the real compatibility engine against the real ~/Games tree and shows what
# the launcher would show. If this prints a library, every layer below it —
# kernel, compositor, scanner, router — is working.
set -uo pipefail

readonly OMNICTL=/usr/local/bin/omnictl

# Open a terminal and re-run inside it when there is nowhere to draw. The test
# is whether stdout is a terminal, not whether WAYLAND_DISPLAY is set: Hyprland
# does not guarantee that variable in an exec-once child, and keying off it
# meant the launcher wrote its whole UI to a stdout nobody could see.
if [[ ! -t 1 && -z "${OMNI_IN_TERMINAL:-}" ]]; then
    export OMNI_IN_TERMINAL=1
    for term in foot kitty alacritty; do
        if command -v "$term" >/dev/null 2>&1; then
            exec "$term" -- "$0" "$@"
        fi
    done
fi

if [[ ! -x "$OMNICTL" ]]; then
    echo "omnictl is not installed on this image."
    echo "scripts/build-iso.sh builds it from src/ and installs it here."
    exec bash -i
fi

"$OMNICTL" init

# The boot splash is held up deliberately (plymouth-quit.service is masked) so
# it covers Hyprland's startup instead of leaving a black screen. Now that
# there is a UI to reveal, take it down. --retain-splash leaves the last frame
# painted so the handoff is not a flash of black.
if command -v plymouth >/dev/null 2>&1; then
    plymouth quit --retain-splash >/dev/null 2>&1 || true
fi

while true; do
    clear
    cat <<'BANNER'
   ___                 _  ___  ___
  / _ \ _ __ ___  _ __ (_)/ _ \/ __|
 | (_) | '  \/ _ \| '  \| | (_) \__ \
  \___/|_|_|_\___/|_|_|_|_|\___/|___/   0.1.0
  Play everything.

BANNER
    "$OMNICTL" scan --quiet
    "$OMNICTL" list
    echo
    echo "  [id] launch (dry run)   e) engines   p) platforms   s) shell   q) quit"
    printf '  > '
    read -r choice || break

    case "$choice" in
        e) "$OMNICTL" engines ;;
        p) "$OMNICTL" platforms ;;
        s) echo "  type 'exit' to come back"; bash -i ;;
        q) break ;;
        "") continue ;;
        *) "$OMNICTL" info "$choice"; "$OMNICTL" launch "$choice" ;;
    esac

    printf '\n  press enter to continue '
    read -r _ || break
done
