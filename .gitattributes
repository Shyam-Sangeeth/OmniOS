# Default: let git normalise text in the repo.
* text=auto

# Everything that a Linux host executes or parses must stay LF, even when
# checked out on Windows. Routes A and B in docs/BUILDING.md mount this working
# tree straight into a Linux container or WSL, where a CRLF shebang fails as
# "bad interpreter: /usr/bin/env bash^M".
*.sh            text eol=lf
*.cfg           text eol=lf
*.conf          text eol=lf
*.preset        text eol=lf
iso/**          text eol=lf
scripts/**      text eol=lf
CMakeLists.txt  text eol=lf

# PowerShell is the one thing that stays CRLF.
*.ps1           text eol=crlf

# Binaries must be exempt from all of the above. The iso/** rule is a glob and
# happily claims the Plymouth artwork as text, which would rewrite line endings
# inside the PNG streams and corrupt them on checkout.
*.png           binary
*.jpg           binary
*.gz            binary
*.zst           binary
*.iso           binary
*.opkg          binary
*.bin           binary
