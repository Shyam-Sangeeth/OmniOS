#!/bin/sh
# Bring the display back after a resume.
#
# Waking from S3 came back to a stuck OmniOS splash rather than the session.
# Plymouth ships no sleep hook of its own, and this profile masks
# plymouth-quit.service — the boot handoff needs that — so on resume there was
# nothing at all whose job it was to take the splash down, and plymouthd sat
# holding DRM master with the compositor unable to draw behind it.
#
# Switching the outputs back on is KWin's own business on resume; this hook
# only has to get the splash out of its way.
#
# Named zz- so it runs after anything else that lands in this directory.
#
# Never fails the resume: a machine that will not come back to its screen is
# bad, but a systemd sleep hook returning non-zero makes the resume itself an
# error, which is worse and harder to see.
set -u

[ "${1:-}" = "post" ] || exit 0

# Ask nicely, then insist. "plymouth quit" is a request to a daemon that may
# already be gone, and the exit status of that is not worth acting on.
plymouth quit >/dev/null 2>&1 || true
pkill -x plymouthd >/dev/null 2>&1 || true

exit 0
